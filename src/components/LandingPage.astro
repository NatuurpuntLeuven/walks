---
import HomeNl, { frontmatter as metaNl } from "../content/pages/nl/home.md";
import HomeEn, { frontmatter as metaEn } from "../content/pages/en/home.md";
import heroImage from "../../data/wijgmaalbroek/images/koekoeksbloem-kevin-feytons.jpg";
import contentNl from "../i18n/content.nl.json";
import contentEn from "../i18n/content.en.json";
import { walks } from "../data/walks";
import { sitePath } from "../lib/urls";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props {
  lang: "nl" | "en";
}

const { lang } = Astro.props;
const copy = lang === "nl" ? contentNl : contentEn;
const meta = lang === "nl" ? metaNl : metaEn;
const HomeContent = lang === "nl" ? HomeNl : HomeEn;
const homePath = sitePath(lang === "nl" ? "" : "en/");
const alternatePath = sitePath(lang === "nl" ? "en/" : "");
const mapPath = sitePath(lang === "nl" ? "map/" : "en/map/");
const healthPath = sitePath(lang === "nl" ? "health/" : "en/health/");
const wijgmaalbroekPath = sitePath(lang === "nl" ? "wijgmaalbroek/" : "en/wijgmaalbroek/");
---

<BaseLayout
  lang={lang}
  title={`${meta.title} | Natuurpunt Leuven`}
  description={meta.description}
  canonicalPath={homePath}
  alternatePath={alternatePath}
>
  <SiteHeader lang={lang} page="home" />

  <main id="main-content">
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{copy.hero.eyebrow}</p>
          <h1>{copy.hero.title}</h1>
          <div class="hero-summary"><HomeContent /></div>
          <div class="button-row">
            <a class="button button--primary" href="#walks">{copy.hero.primaryAction}</a>
            <a class="button button--secondary" href={mapPath}>
              {copy.hero.secondaryAction}
              <span aria-hidden="true">→</span>
            </a>
            <a class="button button--secondary" href={healthPath}>
              {copy.hero.healthAction}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <figure class="hero-visual">
          <div class="hero-image-wrap">
            <img
              src={heroImage.src}
              width={heroImage.width}
              height={heroImage.height}
              alt={copy.hero.imageAlt}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <figcaption>
            <span>{copy.hero.imageLabel}</span>
            <small>{copy.hero.imageCredit}</small>
          </figcaption>
        </figure>
      </div>

      <div class="shell highlight-bar" aria-label={copy.hero.eyebrow}>
        {copy.highlights.map((item) => (
          <div class="highlight-item">
            <strong>{item.value}</strong>
            <span>{item.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section wellbeing" id="health">
      <div class="shell wellbeing-grid">
        <div class="section-intro">
          <p class="eyebrow">{copy.wellbeing.eyebrow}</p>
          <h2>{copy.wellbeing.title}</h2>
          <p>{copy.wellbeing.intro}</p>
          <a class="text-link wellbeing-link" href={healthPath}>
            {copy.wellbeing.action} <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="benefit-list">
          <article class="benefit-card">
            <div class="icon-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" role="img">
                <path d="M4 13.5c2.5-1.5 4.1-4.5 5.2-8 3.7 1.4 6.3 4 7.8 7.7M7.5 18.5c2-3.2 5.3-5.5 10.5-6.5M6.5 21c2.8-.6 5.1-1.7 6.9-3.3" />
              </svg>
            </div>
            <div>
              <h3>{copy.wellbeing.movementTitle}</h3>
              <p>{copy.wellbeing.movementText}</p>
            </div>
          </article>

          <article class="benefit-card">
            <div class="icon-badge icon-badge--lime" aria-hidden="true">
              <svg viewBox="0 0 24 24" role="img">
                <path d="M5 19c0-7.2 4.3-12.2 14-14-1.2 9.2-5.7 13.8-14 14Zm0 0c3.4-4.2 6.8-6.7 10.3-8.6" />
              </svg>
            </div>
            <div>
              <h3>{copy.wellbeing.natureTitle}</h3>
              <p>{copy.wellbeing.natureText}</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section walks-section" id="walks">
      <div class="shell">
        <div class="section-heading-row">
          <div class="section-intro section-intro--wide">
            <p class="eyebrow">{copy.walks.eyebrow}</p>
            <h2>{copy.walks.title}</h2>
            <p>{copy.walks.intro}</p>
          </div>
          <a class="text-link" href={mapPath}>{copy.mapTeaser.action} <span aria-hidden="true">→</span></a>
        </div>

        <div class="walk-grid">
          {walks.map((walk) => (
            <article class="walk-card" style={`--walk-color: ${walk.color}`}>
              <div class="walk-card__top">
                <span class="walk-number">{String(walk.number).padStart(2, "0")}</span>
                <span class="walk-type">{copy.walks.types[walk.type]}</span>
              </div>
              <div class="walk-card__body">
                <h3>{walk.name}</h3>
                <p>{copy.walks.status}</p>
                {walk.id === "wijgmaalbroek" && <a class="walk-card__link" href={wijgmaalbroekPath}>{copy.walks.detailAction} <span aria-hidden="true">→</span></a>}
              </div>
              <div class="walk-card__route" aria-hidden="true">
                <svg viewBox="0 0 160 46" preserveAspectRatio="none">
                  <path d="M2 35C28 8 42 44 68 20s39 17 55-2 24-5 35-15" />
                  <circle cx="2" cy="35" r="3" />
                  <circle cx="158" cy="3" r="3" />
                </svg>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section map-teaser">
      <div class="shell map-teaser-card">
        <div class="map-teaser-copy">
          <p class="eyebrow eyebrow--light">{copy.mapTeaser.eyebrow}</p>
          <h2>{copy.mapTeaser.title}</h2>
          <p>{copy.mapTeaser.text}</p>
          <a class="button button--light" href={mapPath}>
            {copy.mapTeaser.action}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="map-illustration" aria-hidden="true">
          <svg viewBox="0 0 500 320" role="img">
            <path class="map-shape" d="M32 94 153 29l121 44 92-37 99 73-35 129-129 54-104-38-117 37-48-89Z" />
            <path class="map-river" d="M74 51c58 52 24 92 91 118s79-36 131-2 32 80 112 105" />
            <path class="map-route" d="M104 219c7-55 73-39 76-92 3-43 55-62 91-35 46 34 18 89 80 99" />
            <circle class="map-pin" cx="104" cy="219" r="9" />
            <circle class="map-pin" cx="351" cy="191" r="9" />
          </svg>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} />
</BaseLayout>
